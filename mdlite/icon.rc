#include <windows.h>

1 ICON "icon.ico"

1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "MDLite Project"
            VALUE "FileDescription",  "MDLite Markdown Editor"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "MDLite"
            VALUE "LegalCopyright",   "Copyright (C) 2026 MDLite Project. MIT License."
            VALUE "OriginalFilename", "MDLite.exe"
            VALUE "ProductName",      "MDLite"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

1 24 "mdlite.manifest"
